# Copy to pool.env outside source control. Preprod is the mandatory first stage.
# Network
NETWORK=preprod
CARDANO_NODE_NETWORK_ID=1
CARDANO_NODE_SOCKET_PATH=/run/cardano/node.socket
CARDANO_NODE_VERSION=11.0.1
CARDANO_NODE_SHA256_AMD64=40e88a543564251338c4888ef79fde51d2306c18b48ac308c9eab3220e3a13f0
CARDANO_NODE_SHA256_ARM64=c66ca441048630051de1d1c0c2f3b988c5fc97eab80052202f052517c4c6e428
CARDANO_CONFIG_BASE_URL=https://book.world.dev.cardano.org/environments/preprod

# CardFi pool identity
POOL_NAME=CardFi Native Stake Pool
POOL_TICKER=CFI
POOL_DESCRIPTION=CardFi-operated Cardano stake pool supporting native staking and the CardFi ecosystem.
POOL_HOMEPAGE=https://doki03164.github.io/CARDFI/
POOL_METADATA_URL=https://doki03164.github.io/CARDFI/pool.json

# Economics (lovelace / fraction)
POOL_PLEDGE_LOVELACE=500000000000
POOL_COST_LOVELACE=QUERY_MIN_POOL_COST
POOL_MARGIN=0.02

# Network topology
RELAY_1_DNS=HOST_RELAY_1
RELAY_2_DNS=HOST_RELAY_2
RELAY_PORT=3001
BP_PORT=6000
NODE_PROMETHEUS_PORT=12798
ADMIN_SSH_CIDR=TARGET_ADMIN_PUBLIC_IP/32
RELAY_1_PRIVATE_CIDR=TARGET_RELAY_1_PRIVATE_IP/32
RELAY_2_PRIVATE_CIDR=TARGET_RELAY_2_PRIVATE_IP/32

# File locations — secrets are never committed
POOL_KEYS_DIR=/secure/offline/cardfi-pool
PAYMENT_ADDR_FILE=/secure/payment/payment.addr
STAKE_VKEY_FILE=/secure/stake/stake.vkey
STAKE_SKEY_FILE=/secure/stake/stake.skey

# Host installation
NODE_ROLE=relay
CARDANO_USER=cardano
CARDANO_CONFIG_DIR=/etc/cardano
CARDANO_DB_DIR=/var/lib/cardano/db
CARDANO_RUNTIME_DIR=/run/cardano

# Mainnet raw-key generation remains disabled unless explicitly acknowledged.
ALLOW_MAINNET_RAW_KEYS=NO
STAKE_ALREADY_REGISTERED=NO

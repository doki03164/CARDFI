# Network
NETWORK=preprod
CARDANO_NODE_NETWORK_ID=1
CARDANO_NODE_SOCKET_PATH=/run/cardano/node.socket

# CardFi pool identity
POOL_NAME=CardFi Native Stake Pool
POOL_TICKER=CFI
POOL_DESCRIPTION=CardFi-operated Cardano stake pool supporting native staking and the CardFi ecosystem.
POOL_HOMEPAGE=https://TARGET_DOMAIN/stake
POOL_METADATA_URL=https://TARGET_DOMAIN/.well-known/cardfi-pool.json

# Economics (lovelace / fraction)
POOL_PLEDGE_LOVELACE=500000000000
POOL_COST_LOVELACE=QUERY_MIN_POOL_COST
POOL_MARGIN=0.02

# Network topology
RELAY_1_DNS=HOST_RELAY_1
RELAY_2_DNS=HOST_RELAY_2
RELAY_PORT=3001
BP_PORT=6000

# File locations — secrets are never committed
POOL_KEYS_DIR=/secure/offline/cardfi-pool
PAYMENT_ADDR_FILE=/secure/payment/payment.addr
STAKE_VKEY_FILE=/secure/stake/stake.vkey
STAKE_SKEY_FILE=/secure/stake/stake.skey

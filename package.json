{
  "name": "cardfi-protocol",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "contracts:check": "aiken check contracts",
    "contracts:build": "aiken build contracts",
    "deploy:manifest": "node scripts/generate-deployment-manifest.mjs",
    "deploy:manifest:check": "node scripts/generate-deployment-manifest.mjs --check",
    "stake-pool:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/stake-pool/scripts/verify-templates.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@aiken-lang/aiken": "^1.1.23",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  }
}
